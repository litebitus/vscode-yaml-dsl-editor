{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "Resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": { "Type": { "enum": ["Mock::Bucket", "Mock::Queue"] } },
        "allOf": [
          {
            "if": { "properties": { "Type": { "const": "Mock::Bucket" } }, "required": ["Type"] },
            "then": {
              "properties": {
                "Properties": {
                  "type": "object",
                  "properties": { "BucketName": { "type": "string", "description": "The bucket name." } }
                }
              }
            }
          },
          {
            "if": { "properties": { "Type": { "const": "Mock::Queue" } }, "required": ["Type"] },
            "then": {
              "properties": {
                "Properties": {
                  "type": "object",
                  "properties": { "QueueName": { "type": "string", "description": "The queue name." } }
                }
              }
            }
          }
        ]
      }
    }
  }
}
