{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "mocktype": {
      "dependentSchemas": {
        "queue": {
          "anyOf": [
            {
              "required": [
                "role"
              ]
            },
            {
              "$ref": "#/$defs/node"
            }
          ]
        }
      },
      "properties": {
        "queue": {
          "type": "string",
          "description": "the mock queue"
        },
        "role": {
          "type": "string",
          "description": "the mock role"
        },
        "pair": {
          "prefixItems": [
            {
              "description": "the first of the pair"
            }
          ],
          "items": {
            "description": "every later item"
          }
        },
        "named": {
          "$dynamicRef": "#mock-node"
        },
        "old": {
          "description": "use pair",
          "deprecated": true
        }
      }
    }
  },
  "$defs": {
    "node": {
      "$dynamicAnchor": "mock-node",
      "properties": {
        "label": {
          "description": "the named label"
        }
      }
    }
  }
}
