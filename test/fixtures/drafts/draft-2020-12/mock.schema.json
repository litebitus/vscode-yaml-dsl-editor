{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "mocktype": {
      "if": {
        "required": [
          "old"
        ]
      },
      "then": {
        "properties": {
          "mappings": {
            "additionalProperties": {
              "not": {
                "description": "Mock: no `color` here.",
                "type": "object",
                "required": [
                  "color"
                ]
              }
            }
          }
        }
      },
      "dependentSchemas": {
        "queue": {
          "anyOf": [
            {
              "required": [
                "role"
              ]
            },
            {
              "$ref": "#/$defs/node"
            }
          ]
        }
      },
      "properties": {
        "entries": {
          "additionalProperties": {
            "description": "a mock entry",
            "properties": {
              "id": {
                "type": "string",
                "description": "the entry's identity"
              }
            }
          }
        },
        "keyed": {
          "$ref": "#/$defs/keyed_fields",
          "allOf": [
            {
              "$ref": "#/$defs/keyed_document"
            }
          ]
        },
        "queue": {
          "type": "string",
          "description": "the mock queue"
        },
        "role": {
          "type": "string",
          "description": "the mock role"
        },
        "pair": {
          "prefixItems": [
            {
              "description": "the first of the pair"
            }
          ],
          "items": {
            "description": "every later item"
          }
        },
        "named": {
          "$dynamicRef": "#mock-node"
        },
        "old": {
          "description": "use pair",
          "deprecated": true
        },
        "mappings": {
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "string",
                "description": "write it as text",
                "deprecated": true
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "keyed_document": {
      "properties": {
        "keyed_body": {
          "type": "string",
          "description": "the keyed body"
        }
      }
    },
    "keyed_fields": {
      "properties": {
        "keyed_label": {
          "type": "string",
          "description": "the keyed label"
        }
      }
    },
    "node": {
      "$dynamicAnchor": "mock-node",
      "properties": {
        "label": {
          "description": "the named label"
        }
      }
    }
  }
}
