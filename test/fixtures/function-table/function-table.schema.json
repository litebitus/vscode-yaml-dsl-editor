        { "name": "parameter", "type": "text", "required": true, "repeated": false, "description": "The mock parameter name." }
      ],
      "return": { "type": "text", "description": "The mock **value**." }
    },
    "legacy": [
      { "name": "value", "type": "text", "required": true, "repeated": false }
    ]
  }
}
