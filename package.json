{
  "name": "yaml-dsl-editor",
  "displayName": "YAML DSL Editor",
  "description": "The editor that makes a YAML DSL authorable.",
  "version": "0.8.5",
  "publisher": "lite2073",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/litebitus/vscode-yaml-dsl-editor.git"
  },
  "engines": {
    "vscode": "^1.107.0",
    "node": ">=22"
  },
  "vscodeTestVersions": [
    "1.107.0",
    "1.140.0"
  ],
  "categories": [
    "Programming Languages"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#f4efe6",
    "theme": "light"
  },
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:yaml-dsl",
    "workspaceContains:**/yaml-dsl.yml"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "YAML DSL Editor",
      "properties": {
        "yaml-dsl-editor.cache.schemaCapacity": {
          "type": "integer",
          "minimum": 1,
          "default": 32,
          "description": "Distinct schemas kept beyond those a loaded stack uses. The least recently used is dropped first."
        },
        "yaml-dsl-editor.cache.stackCapacity": {
          "type": "integer",
          "minimum": 1,
          "default": 32,
          "description": "Stacks kept beyond the pinned ones. The least recently used is dropped first."
        },
        "yaml-dsl-editor.features.suggestions": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ],
          "default": "on",
          "description": "Suggestions: a suggestion mark in the gutter and an inlay hint whose hover offers the edit.",
          "deprecationMessage": "Deprecated: use the yaml-dsl-editor.suggestion.<kind>.enabled settings."
        },
        "yaml-dsl-editor.suggestion.delete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Delete suggestions: a key an overlay holds the same as the common layer, offered for deletion."
        },
        "yaml-dsl-editor.suggestion.delete.fileDecoration": {
          "type": "boolean",
          "default": true,
          "description": "A file holding a delete suggestion, and every folder above it, named in the suggestion color with the suggestion mark as its badge."
        },
        "yaml-dsl-editor.suggestion.move.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Move suggestions: a unit every overlay holds alike, offered for a move into the common layer."
        },
        "yaml-dsl-editor.suggestion.move.fileDecoration": {
          "type": "boolean",
          "default": true,
          "description": "A file holding a move suggestion, and every folder above it, named in the suggestion color with the suggestion mark as its badge."
        },
        "yaml-dsl-editor.suggestion.potentialMove.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Potential move suggestions: a move whose choice is the user's, shown as information."
        },
        "yaml-dsl-editor.suggestion.rename.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Rename suggestions: a name edited by hand, offered for a rename across the stack."
        },
        "yaml-dsl-editor.suggestion.rename.fileDecoration": {
          "type": "boolean",
          "default": true,
          "description": "A file holding a rename suggestion, and every folder above it, named in the suggestion color with the suggestion mark as its badge."
        },
        "yaml-dsl-editor.theme": {
          "type": "string",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "enumDescriptions": [
            "Follow the editor's theme: light for a light or high contrast light theme, dark for any other.",
            "The dark palette.",
            "The light palette."
          ],
          "default": "auto",
          "description": "The palette the extension draws its colors from."
        },
        "yaml-dsl-editor.warning.deprecation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Deprecation warnings: a field the schema marks deprecated is struck through and marked in the gutter."
        },
        "yaml-dsl-editor.warning.deprecation.fileDecoration": {
          "type": "boolean",
          "default": true,
          "description": "A file holding a deprecation warning, and every folder above it, named in the warning color with a warning badge."
        },
        "yaml-dsl-editor.validator.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Validation: each document is checked against its schema, and each validation error is a problem."
        },
        "yaml-dsl-editor.validator.errorSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "default": "warning",
          "description": "The severity a validation error is shown with."
        },
        "yaml-dsl-editor.validator.fileDecoration": {
          "type": "boolean",
          "default": false,
          "description": "A file holding a validation error, and every folder above it, named in the color of the error's severity with its badge."
        }
      }
    },
    "configurationDefaults": {
      "[yaml-dsl]": {
        "editor.inlayHints.enabled": "on",
        "editor.inlayHints.maximumLength": 64,
        "editor.quickSuggestions": {
          "strings": "on"
        },
        "editor.semanticHighlighting.enabled": true,
        "editor.wordBasedSuggestions": "off"
      }
    },
    "semanticTokenScopes": [
      {
        "language": "yaml-dsl",
        "scopes": {
          "function": [
            "support.function.hcl"
          ],
          "keyword": [
            "support.function.builtin.hcl"
          ],
          "operator": [
            "keyword.operator.accessor.hcl"
          ],
          "type": [
            "entity.name.type.hcl"
          ],
          "variable": [
            "variable.other.readwrite.hcl"
          ],
          "variable.defaultLibrary": [
            "variable.language.hcl"
          ]
        }
      }
    ],
    "languages": [
      {
        "id": "yaml-dsl",
        "aliases": [
          "YAML DSL"
        ],
        "icon": {
          "light": "./media/fileicon.svg",
          "dark": "./media/fileicon.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "yaml-dsl-overlay-diff",
        "aliases": [
          "YAML DSL overlay diff"
        ]
      },
      {
        "id": "yaml-dsl-signature",
        "aliases": [
          "YAML DSL signature"
        ]
      }
    ],
    "grammars": [
      {
        "language": "yaml-dsl",
        "scopeName": "source.yaml.dsl",
        "path": "./syntaxes/yaml-dsl.tmLanguage.json"
      },
      {
        "language": "yaml-dsl-overlay-diff",
        "scopeName": "source.yaml.dsl.overlay-diff",
        "path": "./syntaxes/yaml-dsl-overlay-diff.tmLanguage.json"
      },
      {
        "language": "yaml-dsl-signature",
        "scopeName": "source.yaml.dsl.signature",
        "path": "./syntaxes/yaml-dsl-signature.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "yaml-dsl-editor.diffAcrossOverlays",
        "title": "Diff across overlays",
        "category": "YAML DSL",
        "icon": "$(diff)"
      },
      {
        "command": "yaml-dsl-editor.chooseDiffOverlays",
        "title": "Choose overlays to diff",
        "category": "YAML DSL",
        "icon": "$(filter)"
      },
      {
        "command": "yaml-dsl-editor.toggleTheme",
        "title": "Toggle light/dark theme",
        "category": "YAML DSL",
        "icon": "$(color-mode)"
      }
    ],
    "keybindings": [
      {
        "key": "tab",
        "command": "selectNextSuggestion",
        "when": "editorLangId == yaml-dsl && suggestWidgetVisible && suggestWidgetMultipleSuggestions && textInputFocus"
      },
      {
        "key": "tab",
        "command": "yaml-dsl-editor.acceptLoneSuggestion",
        "when": "editorLangId == yaml-dsl && suggestWidgetVisible && !suggestWidgetMultipleSuggestions && suggestWidgetHasFocusedSuggestion && textInputFocus"
      },
      {
        "key": "shift+tab",
        "command": "selectPrevSuggestion",
        "when": "editorLangId == yaml-dsl && suggestWidgetVisible && suggestWidgetMultipleSuggestions && textInputFocus"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "yaml-dsl-editor.diffAcrossOverlays",
          "when": "resourceLangId == yaml-dsl && resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "yaml-dsl-editor.chooseDiffOverlays",
          "when": "resourceScheme == yaml-dsl-overlay-diff",
          "group": "navigation"
        },
        {
          "command": "yaml-dsl-editor.toggleTheme",
          "when": "resourceLangId == yaml-dsl && resourceScheme == file",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "yaml-dsl-editor.diffAcrossOverlays",
          "when": "editorLangId == yaml-dsl && editorHasSelection",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "yaml-dsl-editor.diffAcrossOverlays",
          "when": "resourceLangId == yaml-dsl && resourceScheme == file"
        },
        {
          "command": "yaml-dsl-editor.chooseDiffOverlays",
          "when": "resourceScheme == yaml-dsl-overlay-diff"
        }
      ]
    },
