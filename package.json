{
  "name": "yaml-dsl-editor",
  "displayName": "YAML DSL Editor",
  "description": "The editor that makes a YAML DSL authorable.",
  "version": "0.0.1",
  "publisher": "lite2073",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/litebitus/vscode-yaml-dsl-editor.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#f4efe6",
    "theme": "light"
  },
  "activationEvents": [
    "workspaceContains:yaml-dsl.yml",
    "onLanguage:yaml-dsl"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "yaml-dsl",
        "aliases": [
          "YAML DSL"
        ],
        "icon": {
          "light": "./fileicon.svg",
          "dark": "./fileicon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yaml-dsl",
        "scopeName": "source.yaml.dsl",
        "path": "./syntaxes/yaml-dsl.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "make test"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "yaml": "^2.8.0"
  }
}
