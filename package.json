{
  "name": "yaml-dsl-editor",
  "displayName": "YAML DSL Editor",
  "description": "The editor that makes a YAML DSL authorable.",
  "version": "0.5.3",
  "publisher": "lite2073",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/litebitus/vscode-yaml-dsl-editor.git"
  },
  "engines": {
    "vscode": "^1.107.0",
    "node": ">=22"
  },
  "vscodeTestVersions": [
    "1.107.0",
    "1.140.0"
  ],
  "categories": [
    "Programming Languages"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#f4efe6",
    "theme": "light"
  },
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:yaml-dsl",
    "workspaceContains:yaml-dsl.yml"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "YAML DSL Editor",
      "properties": {
        "yaml-dsl-editor.cache.schemaCapacity": {
          "type": "integer",
          "minimum": 1,
          "default": 32,
          "description": "Distinct schemas kept beyond those a loaded stack uses. The least recently used is dropped first."
        },
        "yaml-dsl-editor.cache.stackCapacity": {
          "type": "integer",
          "minimum": 1,
          "default": 32,
          "description": "Stacks kept beyond the pinned ones. The least recently used is dropped first."
        },
        "yaml-dsl-editor.features.suggestions": {
          "type": "string",
          "enum": [
            "on",
            "off"
          ],
          "default": "on",
          "description": "Suggestions: a light bulb in the gutter and an inlay hint whose hover offers the edit.",
          "deprecationMessage": "Deprecated: use the yaml-dsl-editor.suggestion.<kind>.enabled settings."
        },
        "yaml-dsl-editor.suggestion.delete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Delete suggestions: a key an overlay holds the same as the common layer, offered for deletion."
        },
        "yaml-dsl-editor.suggestion.delete.fileDecoration": {
          "type": "boolean",
          "default": true,
          "description": "A file holding a delete suggestion, and every folder above it, named in the light bulb color with a light bulb badge."
        },
        "yaml-dsl-editor.suggestion.move.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Move suggestions: a unit every overlay holds alike, offered for a move into the common layer."
        },
        "yaml-dsl-editor.suggestion.move.fileDecoration": {
          "type": "boolean",
          "default": true,
          "description": "A file holding a move suggestion, and every folder above it, named in the light bulb color with a light bulb badge."
        },
        "yaml-dsl-editor.suggestion.potentialMove.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Potential move suggestions: a move whose choice is the user's, shown as information."
        },
        "yaml-dsl-editor.suggestion.rename.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Rename suggestions: a name edited by hand, offered for a rename across the stack."
        },
        "yaml-dsl-editor.suggestion.rename.fileDecoration": {
          "type": "boolean",
          "default": true,
          "description": "A file holding a rename suggestion, and every folder above it, named in the light bulb color with a light bulb badge."
        },
        "yaml-dsl-editor.warning.deprecation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Deprecation warnings: a field the schema marks deprecated is struck through and marked in the gutter."
        },
        "yaml-dsl-editor.warning.deprecation.fileDecoration": {
          "type": "boolean",
          "default": true,
          "description": "A file holding a deprecation warning, and every folder above it, named in the warning color with a warning badge."
        }
      }
    },
    "configurationDefaults": {
      "[yaml-dsl]": {
        "editor.inlayHints.enabled": "on",
        "editor.inlayHints.maximumLength": 64,
        "editor.quickSuggestions": {
          "strings": "on"
        },
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenScopes": [
      {
        "language": "yaml-dsl",
        "scopes": {
          "function": [
            "support.function.hcl"
          ],
          "keyword": [
            "support.function.builtin.hcl"
          ],
          "operator": [
            "keyword.operator.accessor.hcl"
          ],
          "type": [
            "entity.name.type.hcl"
          ],
          "variable": [
            "variable.other.readwrite.hcl"
          ],
          "variable.defaultLibrary": [
            "variable.language.hcl"
          ]
        }
      }
    ],
    "languages": [
      {
        "id": "yaml-dsl",
        "aliases": [
          "YAML DSL"
        ],
        "icon": {
          "light": "./media/fileicon.svg",
          "dark": "./media/fileicon.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "yaml-dsl-overlay-diff",
        "aliases": [
          "YAML DSL overlay diff"
        ]
      }
    ],
    "grammars": [
      {
        "language": "yaml-dsl",
        "scopeName": "source.yaml.dsl",
        "path": "./syntaxes/yaml-dsl.tmLanguage.json"
      },
      {
        "language": "yaml-dsl-overlay-diff",
        "scopeName": "source.yaml.dsl.overlay-diff",
        "path": "./syntaxes/yaml-dsl-overlay-diff.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "yaml-dsl-editor.diffAcrossOverlays",
        "title": "Diff across overlays",
        "category": "YAML DSL",
        "icon": "$(diff)"
      },
      {
        "command": "yaml-dsl-editor.chooseDiffOverlays",
        "title": "Choose overlays to diff",
        "category": "YAML DSL",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "yaml-dsl-editor.diffAcrossOverlays",
          "when": "resourceLangId == yaml-dsl && resourceScheme == file",
          "group": "navigation"
        },
        {
          "command": "yaml-dsl-editor.chooseDiffOverlays",
          "when": "resourceScheme == yaml-dsl-overlay-diff",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "yaml-dsl-editor.diffAcrossOverlays",
          "when": "editorLangId == yaml-dsl && editorHasSelection",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "yaml-dsl-editor.diffAcrossOverlays",
          "when": "resourceLangId == yaml-dsl && resourceScheme == file"
        },
        {
          "command": "yaml-dsl-editor.chooseDiffOverlays",
          "when": "resourceScheme == yaml-dsl-overlay-diff"
        }
      ]
    },
    "colors": [
      {
        "id": "yamlDslEditor.warningForeground",
        "description": "Name of a file holding a warning, and of every folder above it.",
        "defaults": {
          "dark": "#ECE200",
          "light": "#ECE200",
          "highContrast": "#ECE200",
          "highContrastLight": "#ECE200"
        }
      },
      {
        "id": "yamlDslEditor.overlayDiff.difference1",
        "description": "Background of a difference in an overlay diff, first color of the palette.",
        "defaults": {
          "dark": "#D68C8C47",
          "light": "#D68C8C47",
          "highContrast": "#D68C8C47",
          "highContrastLight": "#D68C8C47"
        }
      },
      {
        "id": "yamlDslEditor.overlayDiff.difference2",
        "description": "Background of a difference in an overlay diff, second color of the palette.",
        "defaults": {
          "dark": "#82AAD247",
          "light": "#82AAD247",
          "highContrast": "#82AAD247",
          "highContrastLight": "#82AAD247"
        }
      },
      {
        "id": "yamlDslEditor.overlayDiff.difference3",
        "description": "Background of a difference in an overlay diff, third color of the palette.",
        "defaults": {
          "dark": "#D2BE8247",
          "light": "#D2BE8247",
          "highContrast": "#D2BE8247",
          "highContrastLight": "#D2BE8247"
        }
      },
      {
        "id": "yamlDslEditor.overlayDiff.difference4",
        "description": "Background of a difference in an overlay diff, fourth color of the palette.",
        "defaults": {
          "dark": "#8CBE9647",
          "light": "#8CBE9647",
          "highContrast": "#8CBE9647",
          "highContrastLight": "#8CBE9647"
        }
      },
      {
        "id": "yamlDslEditor.overlayDiff.difference5",
        "description": "Background of a difference in an overlay diff, fifth color of the palette.",
        "defaults": {
          "dark": "#AA96D247",
          "light": "#AA96D247",
          "highContrast": "#AA96D247",
          "highContrastLight": "#AA96D247"
        }
      },
      {
        "id": "yamlDslEditor.overlayDiff.difference6",
        "description": "Background of a difference in an overlay diff, sixth color of the palette.",
        "defaults": {
          "dark": "#D7A57D47",
          "light": "#D7A57D47",
          "highContrast": "#D7A57D47",
          "highContrastLight": "#D7A57D47"
        }
      }
    ]
  },
  "scripts": {
    "test": "make test",
    "preversion": "node scripts/changelog-release.js --check",
    "version": "node scripts/changelog-release.js && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@vscode/test-cli": "0.0.10",
    "@vscode/test-electron": "3.1.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.15",
    "yaml": "2.9.1"
  }
}
