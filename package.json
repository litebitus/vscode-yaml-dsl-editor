{
  "name": "yaml-dsl-editor",
  "displayName": "YAML DSL Editor",
  "description": "The editor that makes a YAML DSL authorable.",
  "version": "0.1.0",
  "publisher": "lite2073",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/litebitus/vscode-yaml-dsl-editor.git"
  },
  "engines": {
    "vscode": "^1.107.0",
    "node": ">=22"
  },
  "vscodeTestVersions": [
    "1.107.0",
    "1.140.0"
  ],
  "categories": [
    "Programming Languages"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#f4efe6",
    "theme": "light"
  },
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:yaml-dsl",
    "workspaceContains:yaml-dsl.yml"
  ],
  "main": "./extension.js",
  "contributes": {
    "configurationDefaults": {
      "[yaml-dsl]": {
        "editor.quickSuggestions": {
          "strings": "on"
        },
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenScopes": [
      {
        "language": "yaml-dsl",
        "scopes": {
          "function": [
            "support.function.hcl"
          ],
          "keyword": [
            "support.function.builtin.hcl"
          ],
          "operator": [
            "keyword.operator.accessor.hcl"
          ],
          "type": [
            "entity.name.type.hcl"
          ],
          "variable": [
            "variable.other.readwrite.hcl"
          ],
          "variable.defaultLibrary": [
            "variable.language.hcl"
          ]
        }
      }
    ],
    "languages": [
      {
        "id": "yaml-dsl",
        "aliases": [
          "YAML DSL"
        ],
        "icon": {
          "light": "./fileicon.svg",
          "dark": "./fileicon.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yaml-dsl",
        "scopeName": "source.yaml.dsl",
        "path": "./syntaxes/yaml-dsl.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "make test"
  },
  "devDependencies": {
    "@vscode/test-cli": "0.0.10",
    "@vscode/test-electron": "3.1.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.15",
    "yaml": "2.9.1"
  }
}
