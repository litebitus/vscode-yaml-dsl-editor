{
  "comments": {
    "lineComment": { "comment": "#" }
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"]
  ],
  "colorizedBracketPairs": [],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*- [^\\s#-][^#]*?:\\s+\\S.*$",
      "action": { "indent": "none", "appendText": "  " }
    }
  ]
}
