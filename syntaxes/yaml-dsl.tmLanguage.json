{
  "name": "YAML DSL",
  "scopeName": "source.yaml.dsl",
  "patterns": [
    { "include": "#comment" },
    { "include": "#quotedPair" },
    { "include": "#pair" },
    { "include": "#double" },
    { "include": "#single" },
    { "include": "#brackets" },
    { "include": "#constant" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.hcl",
      "match": "(?:^|(?<=\\s))(#).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.hcl" }
      }
    },
    "quotedPair": {
      "match": "^(\\s*)(\"(?:\\\\.|[^\"\\n])*\"|'(?:[^'\\n])*')\\s*(:)(?=\\s|$)",
      "captures": {
        "2": { "name": "string.quoted.double.hcl" },
        "3": { "name": "keyword.operator.assignment.hcl" }
      }
    },
    "pair": {
      "match": "^(\\s*)([^\\s:#\"'][^:#\\n]*?)\\s*(:)(?=\\s|$)",
      "captures": {
        "2": { "name": "variable.other.readwrite.hcl" },
        "3": { "name": "keyword.operator.assignment.hcl" }
      }
    },
    "double": {
      "name": "string.quoted.double.hcl",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.hcl" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.hcl" } },
      "patterns": [
        { "include": "#escape" }
      ]
    },
    "single": {
      "name": "string.quoted.single.hcl",
      "begin": "'",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.hcl" } },
      "end": "'",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.hcl" } },
      "patterns": [
        { "match": "''", "name": "constant.character.escape.hcl" }
      ]
    },
    "escape": {
      "name": "constant.character.escape.hcl",
      "match": "\\\\."
    },
    "brackets": {
      "patterns": [
        { "match": "\\[", "name": "punctuation.section.brackets.begin.hcl" },
        { "match": "\\]", "name": "punctuation.section.brackets.end.hcl" }
      ]
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.hcl",
          "match": "(?<=:)\\s*(?:true|false|null|~)(?=\\s*(?:#|$))"
        },
        {
          "name": "constant.numeric.integer.hcl",
          "match": "(?<=:)\\s*[-+]?\\d+(?=\\s*(?:#|$))"
        }
      ]
    }
  }
}
